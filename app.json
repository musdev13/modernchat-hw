{
  "expo": {
    "name": "modernchat",
    "slug": "modernchat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "modernchat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "Додаток використовує камеру для запису круглих відеоповідомлень.",
        "NSMicrophoneUsageDescription": "Додаток використовує мікрофон для запису голосових та відеоповідомлень.",
        "NSPhotoLibraryUsageDescription": "Додаток отримує доступ до галереї для відправки фотографій.",
        "NSPhotoLibraryAddUsageDescription": "Додаток зберігає фотографії у вашу галерею."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Дозвольте додатку використовувати камеру для запису відеокружечків.",
          "microphonePermission": "Дозвольте додатку використовувати мікрофон для запису звуку.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Дозвольте додатку використовувати мікрофон для запису голосових повідомлень."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "53ed0c51-a88c-4f35-89cc-a49c1f88bc88"
      }
    },
    "owner": "musdev13"
  }
}
